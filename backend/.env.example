# Forex AlgoTrader - Environment Configuration
# Copy this file to .env and fill in your details

# === MT5 Configuration ===
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=/path/to/MetaTrader5/terminal.exe

# === Trading Configuration ===
# Account size (USD)
ACCOUNT_SIZE=10.0
# Risk per trade (% of account)
RISK_PER_TRADE=2.0
# Maximum open trades
MAX_OPEN_TRADES=1
# Trading symbols (comma-separated)
TRADING_SYMBOLS=EURUSD,GBPUSD,XAUUSD

# === Strategy Parameters ===
FRACTAL_PERIOD=5
MAX_BARS_BETWEEN=30
MAX_CHANNEL_RANGE=0.0
RSI_LENGTH=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MIN_TIMEFRAME_MINUTES=5

# === API Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# === Database ===
DATABASE_URL=sqlite:///./backend/database/trades.db

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./backend/logs/traderobot.log

# === Telegram (Optional) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# === Safety Features ===
# Enable demo account only mode
DEMO_ONLY=True
# Maximum daily loss (% of account)
MAX_DAILY_LOSS=10.0
# Stop trading after X consecutive losses
MAX_CONSECUTIVE_LOSSES=3
